    "list.focusBackground": "#3a2b16",
    "list.highlightForeground": "#d8a657",
    "list.errorForeground": "#ea6962",
    "list.warningForeground": "#d8a657",

    "statusBar.background": "#0b0a08",
    "statusBar.foreground": "#ebdbb2",
    "statusBar.border": "#27231d",
    "statusBar.noFolderBackground": "#0b0a08",
    "statusBar.debuggingBackground": "#d8a657",
    "statusBar.debuggingForeground": "#0f0e0c",
    "statusBarItem.remoteBackground": "#d8a657",
    "statusBarItem.remoteForeground": "#0f0e0c",

    "panel.background": "#0b0a08",
    "panel.border": "#27231d",
    "panelTitle.activeForeground": "#ebdbb2",
    "panelTitle.inactiveForeground": "#7f7567",
    "panelTitle.activeBorder": "#d8a657",

    "input.background": "#181511",
    "input.foreground": "#ebdbb2",
    "input.border": "#332f29",
    "input.placeholderForeground": "#7f7567",
    "inputOption.activeBorder": "#d8a657",
    "inputValidation.errorBackground": "#3c1715",
    "inputValidation.errorBorder": "#7c2e2a",
    "inputValidation.warningBackground": "#352712",
    "inputValidation.warningBorder": "#75551f",
    "inputValidation.infoBackground": "#142729",
    "inputValidation.infoBorder": "#315c61",

    "dropdown.background": "#181511",
    "dropdown.foreground": "#ebdbb2",
    "dropdown.border": "#332f29",

    "button.background": "#d8a657",
    "button.foreground": "#0f0e0c",
    "button.hoverBackground": "#e78a4e",
    "button.secondaryBackground": "#2c2418",
    "button.secondaryForeground": "#ebdbb2",

    "badge.background": "#d8a657",
    "badge.foreground": "#0f0e0c",

