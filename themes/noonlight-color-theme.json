    "menu.background": "#12100d",
    "menu.foreground": "#ebdbb2",
    "menu.selectionBackground": "#3a2b16",
    "menu.border": "#332f29",
    "menubar.selectionBackground": "#211d18",

    "widget.shadow": "#00000066",
    "notifications.background": "#181511",
    "notifications.border": "#332f29",
    "notificationCenterHeader.background": "#12100d",

    "textLink.foreground": "#7daea3",
    "textLink.activeForeground": "#89b482"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7f7567", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.documentation", "comment.block.documentation"],
      "settings": { "foreground": "#9b8f7d", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#89b482" }
    },
    {
      "scope": ["constant.character.escape", "string.escape"],
      "settings": { "foreground": "#e78a4e" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#7daea3" }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language"],
      "settings": { "foreground": "#d3869b" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#ebdbb2" }
    },
    {
      "scope": ["variable.language", "variable.other.constant", "variable.parameter.special"],
      "settings": { "foreground": "#d3869b" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.modifier"],
      "settings": { "foreground": "#ea6962", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#ea6962" }
    },
    {
      "scope": ["storage.type", "storage"],
      "settings": { "foreground": "#ea6962" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#b8bb26", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.method", "variable.function"],
      "settings": { "foreground": "#a9b665", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.type", "support.type", "entity.name.class", "support.class"],
      "settings": { "foreground": "#d8a657" }
    },
    {
      "scope": ["support.type.builtin", "storage.type.built-in", "support.type.primitive"],
      "settings": { "foreground": "#e78a4e" }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.constructor"],
      "settings": { "foreground": "#b8bb26" }
    },
    {
      "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#7daea3" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#d8a657" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#ea6962", "fontStyle": "bold" }
    },
    {
      "scope": ["constant.other.symbol", "constant.other.key"],
      "settings": { "foreground": "#d3869b" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#a89984" }
    },
    {
      "scope": ["constant.other.enum", "variable.other.enummember"],
      "settings": { "foreground": "#d8a657" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#d8a657", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ebdbb2", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#ebdbb2", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.raw"],
      "settings": { "foreground": "#d3869b" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#89b482", "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ea6962" }
    }
  ],
  "semanticTokenColors": {
    "function": { "foreground": "#b8bb26", "bold": true },
    "method": { "foreground": "#a9b665", "bold": true },
    "type": "#d8a657",
    "class": "#d8a657",
    "enum": "#d8a657",
    "enumMember": "#d3869b",
    "property": "#7daea3",
    "variable": "#ebdbb2",
    "parameter": "#ebdbb2",
    "keyword": "#ea6962",
    "string": "#89b482",
    "number": "#d3869b"
  }
}
